{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arca Launcher",
  "version": "0.1.6",
  "identifier": "com.arca.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Arca Launcher", "width": 920, "height": 590, "minWidth": 640, "minHeight": 400, "visible": false, "resizable": true, "fullscreen": false, "maximized": false, "decorations": false },
      { "label": "splash", "title": "Arca Launcher", "url": "index.html?window=splash", "width": 300, "height": 100, "minWidth": 300, "minHeight": 100, "center": true, "decorations": false, "resizable": false, "closable": true, "fullscreen": false, "maximized": false }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
      "installMode": "perMachine",
      "installerHooks": "./hooks.nsh"
      },
      "wix": {
        "fragmentPaths": [
          "./permissions.wxs"
        ],
        "componentGroupRefs": [
          "ArcaLauncherWritableDataFolders"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBM0U0RDNFMEQzNzNCREUKUldUZU96Y05QazArV3VKTHZGYm1acy9QOWdneDRXcTdOcVFYd3ZBUVJIOGszWmsxSExtdnMwVEYK",
      "endpoints": [
        "https://github.com/wristkyion/Arca-Launcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
