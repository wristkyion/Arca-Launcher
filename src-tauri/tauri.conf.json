{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arca Launcher",
  "version": "0.1.4",
  "identifier": "com.arca.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Arca Launcher", "width": 920, "height": 590, "minWidth": 640, "minHeight": 400, "visible": false, "resizable": true, "fullscreen": false, "maximized": false },
      { "label": "splash", "title": "Arca Launcher", "url": "index.html?window=splash", "width": 300, "height": 100, "minWidth": 300, "minHeight": 100, "center": true, "decorations": false, "resizable": false, "closable": true, "fullscreen": false, "maximized": false }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
