{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arca Launcher",
  "version": "0.1.2",
  "identifier": "com.arca.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Arca Launcher", "width": 920, "height": 590, "resizable": true, "fullscreen": false, "maximized": false }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
